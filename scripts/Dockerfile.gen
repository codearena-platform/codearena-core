FROM golang:1.25-alpine

ARG PROTOC_GEN_GO_VERSION=v1.36.11
ARG PROTOC_GEN_GO_GRPC_VERSION=v1.6.1
ARG PROTOC_GEN_OPENAPI_VERSION=v0.7.1

RUN apk add --no-cache protobuf-dev protoc git

# Pin generator versions so protobuf stubs and OpenAPI output are reproducible.
RUN go install google.golang.org/protobuf/cmd/protoc-gen-go@${PROTOC_GEN_GO_VERSION} && \
    go install google.golang.org/grpc/cmd/protoc-gen-go-grpc@${PROTOC_GEN_GO_GRPC_VERSION} && \
    go install github.com/google/gnostic/cmd/protoc-gen-openapi@${PROTOC_GEN_OPENAPI_VERSION}

WORKDIR /workspace
ENTRYPOINT ["protoc"]
